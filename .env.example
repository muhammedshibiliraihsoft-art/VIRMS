# Copy to .env for local use and supply private values. Never commit .env.
DJANGO_ENV=local
DJANGO_SECRET_KEY=<generate-a-private-random-value>
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=<local-database-name>
DB_USER=<local-database-user>
DB_PASSWORD=<local-database-password>
DB_HOST=localhost
DB_PORT=5432
# Staging/production may use DATABASE_URL instead of DB_*.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend.example
# Non-local environments require private S3-compatible object storage:
# OBJECT_STORAGE_ENDPOINT=https://your-r2-endpoint
# OBJECT_STORAGE_BUCKET=<private-bucket>
# OBJECT_STORAGE_ACCESS_KEY=<private-access-key>
# OBJECT_STORAGE_SECRET_KEY=<private-secret-key>
# OBJECT_STORAGE_REGION=auto
