# Copy to .env for local use and supply private values. Never commit .env.
DJANGO_ENV=local
DJANGO_SECRET_KEY=<generate-a-private-random-value>
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=<local-database-name>
DB_USER=<local-database-user>
DB_PASSWORD=<local-database-password>
DB_HOST=localhost
DB_PORT=5432
# Forwarded client IP headers are ignored unless REMOTE_ADDR matches this CIDR allowlist.
# VIRMS_TRUSTED_PROXY_CIDRS=10.0.0.0/8,2001:db8::/32
# VIRMS_FORWARDED_FOR_HEADER=HTTP_X_FORWARDED_FOR
# Shared PostgreSQL login budgets; review capacity for each environment before release.
VIRMS_LOGIN_GLOBAL_LIMIT=300
VIRMS_LOGIN_GLOBAL_WINDOW_SECONDS=60
VIRMS_LOGIN_SOURCE_LIMIT=30
VIRMS_LOGIN_SOURCE_WINDOW_SECONDS=60
VIRMS_LOGIN_IDENTIFIER_LIMIT=3
VIRMS_LOGIN_IDENTIFIER_WINDOW_SECONDS=300
# Staging/production may use DATABASE_URL instead of DB_*.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend.example
# Non-local environments require private S3-compatible object storage:
# OBJECT_STORAGE_ENDPOINT=https://your-r2-endpoint
# OBJECT_STORAGE_BUCKET=<private-bucket>
# OBJECT_STORAGE_ACCESS_KEY=<private-access-key>
# OBJECT_STORAGE_SECRET_KEY=<private-secret-key>
# OBJECT_STORAGE_REGION=auto
